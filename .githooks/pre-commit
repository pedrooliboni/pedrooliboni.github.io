#!/usr/bin/env bash
# Keeps files/Oliboni_CV.pdf in sync with cv-source/main.tex.
# Runs on every commit; does nothing unless main.tex is part of the commit.
# Enabled per clone with:  git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if git diff --cached --name-only | grep -qx 'cv-source/main.tex'; then
  export PATH="$PATH:/Library/TeX/texbin"
  echo "pre-commit: cv-source/main.tex changed, rebuilding files/Oliboni_CV.pdf"
  bash cv-source/build.sh
  git add files/Oliboni_CV.pdf
fi
